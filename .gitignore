# ---------------------------------------------------------------- your install
# profiles.json describes YOUR machine and can carry a database user. The
# example in templates/ is what ships; this one is generated by detect.py.
/realms/profiles.json
/realms/changelog/
/credentials.txt

# SOAP credentials for the in-game GM account.
/control/soap.json

# Which addons you have installed, and where. Per-machine state.
/control/addons_installed.json

# ------------------------------------------------------------- generated data
# ~30 MB, built from the user's own DBCs and world database by
# tools/rebuild-refdata.py. Derived from game data, so it is never committed.
/control/refdata*.json

# ------------------------------------------------------------------- the build
/app/
/tools/appbuild-cache/
/tools/appbuild-venv/
*.spec

# ------------------------------------------------------- screenshots you retake
# docs/img/*.png IS committed - the README needs it. Only scratch output here.
/docs/img/scratch/

# ------------------------------------------------------------------- editor/OS
__pycache__/
*.py[cod]
.venv/
venv/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --------------------------------------------------------------- backup habits
# This project's history used to live in files named like control.py.bak-prewarm.
# It lives in git now; keep strays out of it.
*.bak
*.bak-*
*.orig
*.pre-*
